# Development image — Vite dev server with hot reload.
#
# The source is mounted as a volume by docker-compose.dev.yml, so editing a file on
# the host updates the browser instantly; only node_modules lives inside the container.
FROM node:20-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

EXPOSE 5173

# --host 0.0.0.0 is required: without it Vite only listens inside the container
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
