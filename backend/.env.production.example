# Production environment for the API container — copy to .env.production and fill in.
# Referenced by docker-compose.prod.yml (env_file). Never commit the filled-in copy.

APP_NAME="Caragay Portfolio API"
APP_ENV=production
# php artisan key:generate --show
APP_KEY=
# Debug pages leak file paths, queries and env values — keep this off in production
APP_DEBUG=false
# The API's own public URL (used in generated media URLs)
APP_URL=https://api.yourdomain.com

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# ── Database (Supabase) ──
# One database serves dev and production; take the connection string from
# Supabase → Project settings → Database → Connection string (URI).
# Use the pooled connection (port 6543) for a container that scales.
DB_CONNECTION=pgsql
DB_URL=postgresql://postgres.<project-ref>:<password>@<host>:6543/postgres?sslmode=require
# Reuse connections between requests (saves ~1.8s of TLS setup per request). Each php-fpm
# worker holds one, so keep it off if the pooler runs out of connections.
DB_PERSISTENT=true

# These drivers avoid extra tables/services for a single-instance API
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# ── Frontend ──
# Comma-separated origins allowed by CORS. Must be the live site's exact origin
# (scheme + host, no trailing slash) or the browser blocks every API call.
FRONTEND_URLS=https://yourdomain.com,https://www.yourdomain.com
# Admin token lifetime in minutes (1440 = one day)
SANCTUM_EXPIRATION=1440

# ── Media ──
# The same folder as dev, because both read the same database rows.
# With MEDIA_DRIVER=local, storage/app/public MUST be a persistent volume
# (docker-compose.prod.yml mounts one) or uploads vanish on the next deploy.
# Switching to cloudinary removes that constraint.
MEDIA_DRIVER=local
MEDIA_FOLDER=portfolio
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Container ──
# Leave false and run migrations deliberately (see DEPLOYMENT.md); set true only when
# the release you are deploying is the one whose migrations should hit the shared database.
RUN_MIGRATIONS=false
